# Copy this file to .env and fill in your own email provider's SMTP details.
# No third-party form service is used — mail is sent directly through your own
# email account. Then run the server with these variables loaded, e.g.:
#   node --env-file=.env server.js

# Where requests are delivered (defaults to hi@raymondchuma.com)
TO_EMAIL=hi@raymondchuma.com

# The mailbox the notification is sent FROM (usually the same SMTP account).
FROM_EMAIL=hi@raymondchuma.com

# --- SMTP credentials from your email provider ---
# Examples:
#   Google Workspace: smtp.gmail.com : 587  (use an App Password, not your login)
#   Zoho Mail:        smtp.zoho.com  : 465  (SMTP_SECURE=true)
#   Fastmail:         smtp.fastmail.com : 465 (SMTP_SECURE=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional: port the site runs on (defaults to 4300)
PORT=4300
